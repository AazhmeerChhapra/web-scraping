   "source": [
    "##in this project, we will scrape data from a site, store it in database using sqlite and visualize it using matplotlib\n",
    "import requests\n",
    "from bs4 import BeautifulSoup\n",
    "import sqlite3\n",
    "import matplotlib.pyplot as plt\n",
    "url = 'https://en.m.wikipedia.org/wiki/Le_Monde%27s_100_Books_of_the_Century'\n",
    "page = requests.get(url)\n",
    "soup = BeautifulSoup(page.content,'html.parser')\n",
    "\n",
    "print(soup)  #getting the html page and printing it"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "27876086",
   "metadata": {},
   "outputs": [],
   "source": [
    "print(soup.prettify())
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "af541db1",
   "metadata": {},
   "outputs": [],
   "source": [
    "tbody = soup.tbody\n",
    "print(tbody)  #getting the data in tables"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "5e90980f",
   "metadata": {},
   "outputs": [],
   "source": [
    "trs = tbody.contents\n",
    "print(trs)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "b82bdbb2",
   "metadata": {},
   "outputs": [],
   "source": [
    "print(list(trs[0].next_siblings))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "810f0a19",
   "metadata": {},
   "outputs": [],
   "source": [
    "rows = soup.find_all(\"tr\")\n",
    "print(rows)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "4643aa2c",
   "metadata": {},
   "outputs": [],
   "source": [
    "book_info=[]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "5b9fca3b",
   "metadata": {},
   "outputs": [],
   "source": [
    "#splliting and getting text from td tag and storing them in a list\n",
    "for row in rows[1:-1]:\n",
    "    cells = row.find_all([\"td\"])\n",
    "    info= [cell.get_text(strip=True) for cell in cells]\n",
    "    book_info.append(info)\n",
    "    print(info)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "ac492c44",
   "metadata": {},
   "outputs": [],
   "source": [
    "#creating lists to store data\n",
    "book_id=[]\n",
    "book_name=[]\n",
    "book_author=[]\n",
    "book_publication=[]\n",
    "book_language=[]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "0b0e09b1",
   "metadata": {},
   "outputs": [],
   "source": [
    "##iterating through the cell list to store respective data in each list\n",
    "for lines in book_info:\n",
    "    book_id.append(lines[0])\n",
    "    book_name.append(lines[1])\n",
    "    book_author.append(lines[2])\n",
    "    book_publication.append(lines[3])\n",
    "    book_language.append(lines[4])\n",
    "for a,b,c,d,e in zip(book_id,book_name,book_author,book_publication,book_language):\n",
    "    print(a+b+c+d+e)\n",
    "    "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "87f77340",
   "metadata": {},
   "outputs": [],
   "source": [
    "conn=sqlite3.connect('assignment3.db') ## creating database\n",
    "curr=conn.cursor()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "c000e729",
   "metadata": {},
   "outputs": [],
   "source": []
  },
  {
   "cell_type": "code",
   "execution_count": 22,
   "id": "d6f80330",
   "metadata": {},
   "outputs": [],
   "source": [
    "## creating 2 tables\n",
    "create_table=\"\"\"create table author (author_name text NOT NULL PRIMARY KEY);\"\"\"\n",
    "create_book_table=\"\"\"create table books(book_id integer NOT NULL PRIMARY KEY,\n",
    "book_name text NOT NULL,\n",
    "book_author text,\n",
    "book_publication text,\n",
    "book_language text,\n",
    "foreign key(book_author) references author(author_name)\n",
    ");\"\"\" \n",
    "#populating tables with data\n",
    "insertion=\"\"\"insert into author(author_name) values(?);\"\"\"\n",
    "insert_book=\"\"\"insert into books(book_id,book_name,book_author,book_publication,book_language) values(?, ?, ?, ?, ?);\"\"\"\n",
    "curr.execute(create_table)\n",
    "curr.execute(create_book_table)\n",
    "# getting data from lists and storing them in the database in respective tables and attributes\n",
    "for i in book_author:\n",
    "    curr.execute(insertion,(i,))\n",
    "for a,b,c,d,e in zip(book_id,book_name,book_author,book_publication,book_language):\n",
    "    curr.execute(insert_book,(a,b,c,d,e))\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "conn.commit()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 34,
   "id": "3b6bf041",
   "metadata": {},
   "outputs": [],
   "source": [
    "\n",
    "##graphing data by taking data from database. in this case, we are taking languages and their count\n",
    "graph_selection=\"\"\"select count(book_language) as 'No of books',book_language from books group by book_language order by count(book_language) desc;\"\"\"\n",
    "curr.execute(graph_selection)\n",
    "graph_data=curr.fetchall() ##to store result of query\n",
    "##storing result into 2 different list\n",
    "no_of_books=[]\n",
    "languages=[]\n",
    "for i in range(len(graph_data)):\n",
    "    temp=graph_data[i]\n",
    "    no_of_books.append(temp[0])\n",
    "    languages.append(temp[1])\n",
    "\n",
    "\n",
    "conn.commit()"
   ]
  },
